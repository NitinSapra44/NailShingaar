# ── Used by migrate-to-cloudinary.js and update-db-urls.js only ──
# (full app .env.example with NextAuth / DATABASE_URL vars comes once
# the app-code migration starts)

# Supabase — service_role key (Project Settings → API), NOT the anon key.
# Needed to read from storage buckets during the one-time migration.
SUPABASE_URL=https://mxehvcoednjpvukibjla.supabase.co
SUPABASE_SERVICE_KEY=

# Cloudinary (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Postgres connection string used by update-db-urls.js to rewrite
# stored image URLs after the Cloudinary upload completes.
DATABASE_URL=
