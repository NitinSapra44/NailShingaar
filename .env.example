# ── Database (Railway Postgres) ──
# Railway project → Postgres service → Connect tab → "Postgres Connection URL"
DATABASE_URL=postgresql://user:password@host:port/database

# ── Auth (NextAuth.js) ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Your deployed app URL in production (e.g. https://nailshingaar.up.railway.app);
# http://localhost:3000 in development
NEXTAUTH_URL=http://localhost:3000

# ── File storage (Cloudinary) ──
# Cloudinary Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── One-time Supabase → Cloudinary storage migration only ──
# (not needed by the app itself; used by migrate-to-cloudinary.js /
# update-db-urls.js and then can be removed)
SUPABASE_URL=https://mxehvcoednjpvukibjla.supabase.co
SUPABASE_SERVICE_KEY=
